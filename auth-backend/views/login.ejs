<!DOCTYPE html>
<html lang="ko">
  <%- include("./includes/head", { pageTitle: "Login" }) %>

  <body>
    <%- include("./includes/header", { headerTitle: "Login" }) %>

    <main>
      <section id="login-container" class="input-container">
        <form action="/login" method="POST">
          <ul>
            <li>
              <input
                type="text"
                id="user-id"
                name="userName"
                placeholder="ID"
                value="<%= inputValue.userId %>"
                required
              />
            </li>
            <li>
              <input
                type="password"
                id="user-pw"
                name="userPw"
                placeholder="Password"
                required
              />
            </li>
            <li>
              <% if (errorMessage) { %>
                <p class="error"><%= errorMessage %></p>
              <% } %>
            </li>
          </ul>
          <button type="submit" class="btn">Login</button>
        </form>
      </section>
      <section id="menu-container">
        <ul>
          <li>
            <a href="/sign-up">회원가입</a>
          </li>
          <li>
            <a href="/find-pw">PW 찾기</a>
          </li>
        </ul>
      </section>
    </main>

    <%- include("./includes/footer") %>
  </body>
</html>
