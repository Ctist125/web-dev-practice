<!DOCTYPE html>
<html lang="ko">
  <%- include("./includes/head", { pageTitle: "PW 찾기" }) %>

  <body>
    <%- include("./includes/header", { headerTitle: "PW 찾기" }) %>

    <main>
      <section id="find-pw-container" class="input-container">
        <form action="/find-pw" method="POST">
          <ul>
            <li>
              <input
                type="text"
                id="user-id"
                name="userId"
                placeholder="ID 입력"
                required
              />
            </li>
            <li>
              <% if (errorMessage) { %>
                <p class="error"><%= errorMessage %></p>
              <% } %>
            </li>
          </ul>
          <button type="submit" class="btn">찾기</button>
        </form>
      </section>
    </main>

    <%- include("./includes/footer") %>
  </body>
</html>
