<!DOCTYPE html>
<html lang="ko">
  <%- include("./includes/head", { pageTitle: "Sign up" }) %>

  <body>
    <%- include("./includes/header", { headerTitle: "Sign up" }) %>

    <main>
      <section id="sign-up-container" class="input-container">
        <form action="/sign-up" method="POST">
          <ul>
            <li>
              <input
                type="text"
                id="new-id"
                name="newId"
                placeholder="ID"
                value="<%= inputValue.userId %>"
                required
              />
            </li>
            <li>
              <input
                type="password"
                id="new-pw"
                name="newPw"
                placeholder="Password"
                required
              />
            </li>
            <li>
              <input
                type="password"
                id="pw-check"
                name="pwCheck"
                placeholder="Password 확인"
                required
              />
            </li>
            <li>
              <% if (errorMessage) { %>
                <p class="error"><%= errorMessage %></p>
              <% } %>
            </li>
          </ul>
          <button type="submit" class="btn">Sign up</button>
        </form>
      </section>
    </main>

    <%- include("./includes/footer") %>
  </body>
</html>
